# Razorpay Credentials (Get from https://dashboard.razorpay.com)
RAZORPAY_KEY_ID=rzp_test_XXXXXXXXXXXX
RAZORPAY_KEY_SECRET=your_razorpay_secret_here

# MongoDB (Get free cluster from https://cloud.mongodb.com)
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/ecoworld?retryWrites=true&w=majority

# Server
PORT=5000
NODE_ENV=development

# Frontend URL (for CORS)
FRONTEND_URL=https://ecoworld.earth

# Razorpay Webhook Secret (set in Razorpay Dashboard → Webhooks)
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret_here
JWT_SECRET=your_jwt_secret_here_change_this_to_random_string

# Email (Zoho Mail SMTP)
EMAIL_USER=sales@ecoworld.earth
EMAIL_PASS=your_zoho_app_password_here
